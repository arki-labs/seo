{
  "files": [
    "dist/src/**",
    "!dist/src/**/*.test.*",
    "!dist/src/**/*.test-d.*",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.test-d.ts",
    "README.md",
    "docs/**",
    "llms.txt",
    "CHANGELOG.md",
    "LICENSE",
    "package.json",
    "dist/api.json",
    "dist/errors.json",
    "dist/api-names/**"
  ],
  "name": "@arki/seo",
  "version": "0.1.1",
  "description": "SEO building blocks for web apps: metadata, robots.txt, sitemap.xml and llms.txt builders, JSON-LD schema components, and a TanStack Start head adapter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "seo",
    "json-ld",
    "sitemap",
    "robots",
    "llms-txt",
    "metadata"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./react": {
      "types": "./dist/src/react/index.d.ts",
      "import": "./dist/src/react/index.js",
      "default": "./dist/src/react/index.js"
    },
    "./tanstack-start": {
      "types": "./dist/src/tanstack-start.d.ts",
      "import": "./dist/src/tanstack-start.js",
      "default": "./dist/src/tanstack-start.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "schema-dts": "^2.1.0"
  },
  "peerDependencies": {
    "@arki/icons": "^0.2.0",
    "@arki/ui": "^0.2.0",
    "@tanstack/react-router": "^1.170.45",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "@arki/icons": {
      "optional": true
    },
    "@arki/ui": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "arki": {
    "bundlerOnly": [
      "./react"
    ]
  }
}
